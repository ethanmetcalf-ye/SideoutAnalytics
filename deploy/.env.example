# Production settings. On the server, copy this file to deploy/.env and fill
# in the values. docker compose reads it for postgres, migrate, api and
# scheduler. For local development use the .env.example in the repo root.

# --- Postgres (the postgres image) ---
# The image reads these only when it first creates an empty data volume.
# Changing the password later doesn't change an existing database.
POSTGRES_USER=sideout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sideout

# --- App (read by settings.py) ---

# The host is the compose service name, "postgres". The user, password and
# database must match the POSTGRES_* values above. Use a password with
# only letters and digits (for example `openssl rand -hex 16`): characters
# like @ : / # $ % break this URL or the env file.
DATABASE_URL=postgresql+psycopg://sideout:change-me@postgres:5432/sideout

# The rawpipeline_data volume, mounted by the scheduler.
DATA_DIRECTORY=/data

# Names the environment on Sentry errors. "production" also switches logs to JSON.
ENVIRONMENT=production

# --- Sentry (read by settings.py) ---
# The DSNs of the two Sentry projects: sideout-analytics-api and
# sideout-analytics-pipeline (Settings > Projects > Client Keys in Sentry).
SENTRY_API_DSN=https://your-api-key@your-org.ingest.us.sentry.io/your-api-project-id
SENTRY_PIPELINE_DSN=https://your-pipeline-key@your-org.ingest.us.sentry.io/your-pipeline-project-id

# --- Scheduler pings (read by the shell in deploy/crontab) ---
# Healthchecks.io ping URLs. The crontab appends "/<exit code>" after each
# run and sends no ping when the run is skipped (exit 75).
HOURLYPOLLURL=https://hc-ping.com/your-hourly-poll-check-uuid
SNAPSHOTPINGURL=https://hc-ping.com/your-snapshot-check-uuid

# --- Backups (read by the shell in deploy/backup.sh) ---
# The S3 bucket (and optional prefix) the nightly backup writes to, no trailing slash.
AWSBACKUPS_URL=s3://your-bucket-name
# Optional Healthchecks.io ping URL for the backup. The script appends "/<exit code>".
# BACKUPPINGURL=https://hc-ping.com/your-backup-check-uuid

# --- Optional (defaults shown) ---
# FRESHNESS_STALE_AFTER_MINUTES=120
# NCAA_BASE_API_URL=https://ncaa-api.henrygd.me
# USERAGENT_ID="sideout-analytics/0.1 (+https://github.com/ethanmetcalf-ye/SideoutAnalytics)"
# LOG_LEVEL=INFO
