# Copy this file to .env and fill in the values for your environment.
# Variable names map to fields on settings.Settings (case-insensitive).

# --- Required ---

# Directory where raw/processed data files are stored.
DATA_DIRECTORY=./data

# Database connection string
# e.g. sqlite:///./data/sideout.db
#      postgresql://user:password@localhost:5432/sideout
DATABASE_URL=sqlite:///./data/sideout.db

# --- Optional (defaults shown) ---

# Base URL for the NCAA women's volleyball API.
# NCAA_BASE_API_URL=https://api.ncaa.com/v1/sports/volleyball-women

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
