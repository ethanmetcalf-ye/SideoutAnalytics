# Copy this file to .env and fill in the values for your environment.
# Variable names map to fields on settings.Settings (case-insensitive).

# --- Required ---

# Directory where raw/processed data files are stored.
DATA_DIRECTORY=./data

# Postgres credentials, shared by the local container (compose.yaml)
# and DATABASE_URL below.
DB_USER=sideout
DB_PASSWORD=change-me
DB_NAME=sideout
DB_PORT=5432

# Postgres connection string, built from the values above.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}

# --- Optional (defaults shown) ---

# Postgres for the database tests, read by tests/conftest.py, not the app.
# Tests make their own schema and drop it, so the local database is fine.
# Unset, those tests are skipped.
# TEST_DATABASE_URL=${DATABASE_URL}

# Base URL for the NCAA women's volleyball API.
# NCAA_BASE_API_URL=https://ncaa-api.henrygd.me

# User-Agent sent with every API request, so the operator can identify us.
# USERAGENT_ID="sideout-analytics/0.1 (+https://github.com/ethanmetcalf-ye/SideoutAnalytics)"

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
